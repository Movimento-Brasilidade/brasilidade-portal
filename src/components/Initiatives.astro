---
import type { CollectionEntry } from 'astro:content';
import { entryUrl } from '../lib/content';
interface Props { entries: CollectionEntry<'initiatives'>[] }
const { entries } = Astro.props;
---
<div class="initiative-list">{entries.map((entry, index) => <article class="initiative">
  <div class="initiative-visual" aria-hidden="true"><span>{String(index + 1).padStart(2, '0')}</span><img class="initiative-symbol" src="/brand/symbol-yellow.png" alt="" width="639" height="657" loading="lazy" /></div>
  <div class="initiative-copy"><p class="eyebrow">{entry.data.status}</p><h3>{entry.data.title}</h3><p>{entry.data.description}</p><a class="text-link" href={entryUrl('iniciativas', entry.id)}>Conheça a iniciativa <span aria-hidden="true">↗</span></a></div>
</article>)}</div>
{entries.length === 0 && <p>Novas iniciativas serão apresentadas aqui.</p>}
