---
import { getEntry, render } from 'astro:content';
import { site } from '../config/site';
import Base from '../layouts/Base.astro';

const entry = await getEntry('institutional', 'qr');
if (!entry) throw new Error('Conteúdo da página do QR Code ausente.');
const { title, description } = entry.data;
const { Content } = await render(entry);
---
<Base title={title} description={description}>
  <article class="wrap page article">
    <header class="page-heading">
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      {site.whatsappUrl && <a class="primary-link" href={site.whatsappUrl}>Entre no grupo do WhatsApp <span aria-hidden="true">↗</span></a>}
    </header>
    <div class="prose"><Content /></div>
  </article>
</Base>
