---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
---
<Base description={site.heroText}>
  <section class="landing wrap" aria-labelledby="apresentacao">
    <div class="brand-stage">
      <img class="landing-logo" src="/brand/logo-green.png" alt={site.name} width="1473" height="657" />
      <span class="sun-dot" aria-hidden="true"></span>
    </div>
    <h1 id="apresentacao">{site.heroTitle}<span>{site.heroAccent}</span></h1>
    <p class="landing-intro">{site.heroText}</p>
    {site.instagramUrl && <a class="instagram-button" href={site.instagramUrl}>
      {site.instagramCta} <span aria-hidden="true">↗</span>
    </a>}
  </section>
</Base>
