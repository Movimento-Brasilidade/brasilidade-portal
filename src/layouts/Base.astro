---
import { site } from '../config/site';
import { getPublications } from '../lib/content';
import '../styles/global.css';
import '../styles/brand.css';
import '../styles/landing.css';
interface Props { title?: string; description?: string; image?: string; imageAlt?: string; articleDate?: Date; author?: string; noindex?: boolean }
const { title, description = site.description, image, imageAlt, articleDate, author, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} — Movimento político e social`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialImage = image && Astro.site ? new URL(image, Astro.site).href : undefined;
const hasPublications = (await getPublications()).length > 0;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title><meta name="description" content={description} />
    <meta name="theme-color" content="#2EA452" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}brand/favicon.png`} />
    {(noindex || !Astro.site) && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:locale" content="pt_BR" /><meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} />
    <meta property="og:type" content={articleDate ? 'article' : 'website'} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    {articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}
    {author && <meta name="author" content={author} />}
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <header class="site-header wrap">
      <a class="header-logo" href={import.meta.env.BASE_URL} aria-label="Brasilidade — início"><img src={`${import.meta.env.BASE_URL}brand/logo-green.png`} alt="" width="1473" height="657" /></a>
      <nav aria-label="Navegação principal">
        <a href={`${import.meta.env.BASE_URL}#sobre`}>Quem somos</a>
        <a href={`${import.meta.env.BASE_URL}#projetos-e-ideias`}>Projetos e ideias</a>
        {hasPublications && <a href={`${import.meta.env.BASE_URL}publicacoes/`}>Publicações</a>}
        <a href={`${import.meta.env.BASE_URL}#loja`}>Loja</a>
        <a href={`${import.meta.env.BASE_URL}#participe`}>Participe</a>
      </nav>
    </header>
    <main id="conteudo" tabindex="-1"><slot /></main>
    <footer class="site-footer"><div class="wrap footer-inner">
      <p class="copyright">© {site.name} <span>· Portal beta</span></p>
      {site.instagramUrl && <a href={site.instagramUrl}>{site.instagramLabel} <span aria-hidden="true">↗</span></a>}
    </div></footer>
  </body>
</html>
